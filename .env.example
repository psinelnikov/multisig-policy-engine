# 0G Galileo Testnet Configuration
PRIVATE_KEY=your_funded_galileo_private_key

# 0G Galileo Chain (Chain ID: 16602)
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_EXPLORER_URL=https://chainscan-galileo.0g.ai
ZG_EXPLORER_API_URL=https://chainscan-galileo.0g.ai/open/api

# Evaluator service (generates a keypair; the address must match EVALUATOR_SIGNER on contracts)
EVALUATOR_PRIVATE_KEY=your_evaluator_evm_private_key
EVALUATOR_SIGNER=your_evaluator_evm_address
EVALUATOR_PUB_KEY=0x04_your_evaluator_ecies_public_key

# 0G Compute (AI risk check — Phase 3)
ZG_COMPUTE_PROVIDER=0x_teeML_provider_address

# 0G Storage (audit receipts — Phase 4)
ZG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# Governance signers (comma-separated)
GOVERNANCE_SIGNERS=0xSigner1,0xSigner2,0xSigner3

# CoinGecko (oracle — Phase 5)
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# To be filled after deploying (see config/galileo/addresses.md):
WALLET_FACTORY_ADDR=
EVALUATION_GATEWAY_ADDR=
PRESET_POLICY_REGISTRY_ADDR=
MULTISIG_WALLET_SINGLETON_ADDR=
GOVERNANCE_MULTISIG_SINGLETON_ADDR=
POLICY_REGISTRY_SINGLETON_ADDR=
AUDIT_LOG_SINGLETON_ADDR=
POLICY_REGISTRY_ADDR=
AUDIT_LOG_ADDR=
MULTISIG_WALLET_ADDR=
GOVERNANCE_MULTISIG_ADDR=
TEST_TOKEN_ADDR=

# Redis
REDIS_URL=redis://127.0.0.1:6383
